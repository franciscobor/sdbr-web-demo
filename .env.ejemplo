# Copiar como .env en la raíz para ejecutar la web fuera de Docker contra la base de demo.
# Con Docker no hace falta: docker-compose.yml usa demo/docker.env.

# --- SQL Server ---
SDBR_SQL_SERVIDOR=127.0.0.1,14330
SDBR_SQL_BASE=SDBR_DEMO
SDBR_SQL_USUARIO=sdbr_app
SDBR_SQL_PASSWORD=Demo-App-2026!
SDBR_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# "si" con el SQL Server de Docker (certificado autofirmado); "no" con Azure SQL
SDBR_SQL_CONFIAR_CERTIFICADO=si
SDBR_SQL_TIMEOUT_SEG=30

# --- Aplicación web ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SDBR_SECRET_KEY=
# "si" cuando la web se sirva por HTTPS
SDBR_COOKIE_SEGURA=no
SDBR_HOST=127.0.0.1
SDBR_PUERTO=8050
SDBR_HILOS=16

# --- Marca y modo demo ---
# Sin SDBR_EMPRESA se ve solo "SDBR" con el logotipo genérico.
SDBR_EMPRESA=
SDBR_LOGO=logo_sdbr.svg
SDBR_MODO_DEMO=si

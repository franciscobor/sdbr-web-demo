# Variables de la demo con el SQL Server de Docker (docker-compose.yml y pruebas de integración).
# Las contraseñas son solo para ese contenedor local, que publica el puerto en 127.0.0.1: no son
# secretos. Para Azure se usa un archivo propio sin versionar (ver demo/DESPLIEGUE_AZURE.md).
#
# Dentro de compose el servidor es "sqlserver"; desde el equipo, 127.0.0.1 por el puerto 14330 (no "localhost": en Windows
# resuelve primero a ::1 y el puerto solo se publica en IPv4).

SDBR_MODO_DEMO=si
SDBR_SQL_SERVIDOR=127.0.0.1,14330
SDBR_SQL_BASE=SDBR_DEMO
SDBR_SQL_USUARIO=sdbr_app
SDBR_SQL_PASSWORD=Demo-App-2026!
SDBR_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# El SQL Server del contenedor usa un certificado autofirmado
SDBR_SQL_CONFIAR_CERTIFICADO=si
SDBR_SECRET_KEY=clave-solo-para-la-demo-local
SDBR_PUERTO=8050

# Cuenta que crea la base y sus objetos (demo/instalar.py). La aplicación no la usa.
SDBR_DEMO_ADMIN_USUARIO=sa
SDBR_DEMO_ADMIN_PASSWORD=Demo-Admin-2026!
